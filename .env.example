# Environment
NODE_ENV=development

# API
API_PORT=3000
SESSION_SECRET=change-me
# Opaque DB session lifetime (seconds). Default = 7 days.
SESSION_TTL_SECONDS=604800

# Database
DB_HOST=db
DB_PORT=3306
DB_NAME=nbts_blood_ai
DB_USER=nbts
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-root-me

# AI Service
# Host API (bun run on your machine) → loopback where Ollama/AI listens:
AI_SERVICE_URL=http://127.0.0.1:8000
# URL the AI service can call back to for API-owned assistant tools.
API_INTERNAL_BASE_URL=http://127.0.0.1:3000
# Compose API container overrides this to http://ai-service:8000 in docker-compose.yml
# Railway API → http://ai-service.railway.internal:8000 (private DNS; see docs/17)
AI_REQUEST_TIMEOUT_MS=30000
AI_TRAIN_TIMEOUT_MS=120000
AI_HEALTH_TIMEOUT_MS=5000
# Server-to-server secret for POST /api/v1/ai-analysis/scheduled.
AI_ANALYSIS_CRON_SECRET=change-me-ai-analysis-cron

# Frontend (browser → API). Copy to web/.env for Vite local; must match APP_ORIGINS.
# In Docker/Railway this is a BUILD ARG for the web image (Vite bake-time) — rebuild web to change it.
VITE_API_URL=http://localhost:3000/api/v1

# Local-only demo users created by seed (placeholders — change locally).
# NEVER use these values outside local/dev. Do not commit real passwords.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@nbts.local
ADMIN_PASSWORD=ChangeMe-Admin-Local-Only!
DEMO_ADMIN_EMAIL=admin@nbts.local
DEMO_ADMIN_PASSWORD=ChangeMe-Admin-Local-Only!
DEMO_OFFICER_EMAIL=officer@nbts.local
DEMO_OFFICER_PASSWORD=ChangeMe-Officer-Local-Only!

# Container bootstrap (api docker-entrypoint / Compose)
# RUN_MIGRATIONS=true applies Drizzle migrations on API start.
# RUN_SEED=true runs reference seed (blood groups, full RBAC catalogue, centres, facilities).
# SEED_ADMIN_USER=true inserts only ADMIN_* with the System Administrator role.
# SEED_DEMO_USERS=true also inserts demo admin/officer (default off when NODE_ENV=production).
# SEED_DEMO_OPERATIONS=true inserts demo donors/donations/inventory/requests/demand
# (default off when NODE_ENV=production). Independent of SEED_DEMO_USERS — keep false on Railway.
# Needs an ACTIVE user for createdBy (enable SEED_DEMO_USERS locally, or create a user first).
RUN_MIGRATIONS=true
RUN_SEED=true
SEED_ADMIN_USER=false
SEED_DEMO_USERS=true
SEED_DEMO_OPERATIONS=true

# SMTP / Mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@nbts.local

# SMS
SMS_PROVIDER=mock

# LLM — local Docker default uses Ollama + phi4 for testable offline forecasts.
# Railway/prod can override to LLM_PROVIDER=openai with OPENAI_API_KEY.
OLLAMA_ENABLED=true
# Direct Ollama Cloud API: https://ollama.com and OLLAMA_API_KEY.
# Local Compose Ollama profile: http://ollama:11434 with no OLLAMA_API_KEY.
# Host Ollama from containers: http://host.docker.internal:11434.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=phi4
OLLAMA_API_KEY=
# AI service LLM: ollama (local default) | openai | none (see ai-service/README.md, docs/15)
LLM_PROVIDER=ollama
# Local demo forces LLM forecasts through Ollama; set false for statistical/ML only.
LLM_FORECAST_DEFAULT=true
LLM_TIMEOUT_SECONDS=60
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Shortage alert severity thresholds (projected gap = predicted − available units)
ALERT_SEVERITY_LOW_MIN=0.01
ALERT_SEVERITY_MEDIUM_MIN=10
ALERT_SEVERITY_HIGH_MIN=25
ALERT_SEVERITY_CRITICAL_MIN=50

# Security
COOKIE_SECURE=false
# Local same-site localhost can use Strict. Railway split-domain deploys need None + Secure.
SESSION_COOKIE_SAME_SITE=Strict
# Comma-separated browser origins for CORS (credentials) + CSRF Origin checks.
# Include Vite ports: 5173 (default) and 5174 (when 5173 is busy).
APP_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
# Login rate limit (in-memory MVP): max attempts per IP per window.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# AI Service
MODEL_DIR=/app/models
DEFAULT_FORECAST_HORIZON=7
MIN_TRAINING_ROWS=30
